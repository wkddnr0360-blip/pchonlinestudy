{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pch-ons2-local",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "ONS_ENV": "local", "APP_ORIGIN": "http://127.0.0.1:8787" },
  "assets": {
    "directory": "../.ons2/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pch-ons2-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../migrations"
  }],
  "r2_buckets": [{ "binding": "PRIVATE_FILES", "bucket_name": "pch-ons2-private-local" }]
}
