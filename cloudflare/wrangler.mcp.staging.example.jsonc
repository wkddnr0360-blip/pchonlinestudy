{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pch-ons2-mcp-staging",
  "main": "../worker/mcp/index.ts",
  "compatibility_date": "2026-11-25",
  "account_id": "REPLACE_WITH_STAGING_ACCOUNT_ID",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_STAGING_KV_ID" }],
  "services": [{ "binding": "APP", "service": "pch-ons2-staging" }]
}
