{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pch-ons2-staging",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "REPLACE_WITH_STAGING_ACCOUNT_ID",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "vars": { "ONS_ENV": "staging", "APP_ORIGIN": "https://REPLACE_WITH_STAGING_HOST" },
  "assets": {
    "directory": "../.ons2/client",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/release.json", "/api/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pch-ons2-staging",
    "database_id": "REPLACE_WITH_STAGING_D1_ID",
    "migrations_dir": "../migrations"
  }]
}
