{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pch-ons2-staging",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-11-25",
  "account_id": "REPLACE_WITH_STAGING_ACCOUNT_ID",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "ONS_ENV": "staging" },
  "assets": {
    "directory": "../.ons2/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pch-ons2-staging",
    "database_id": "REPLACE_WITH_STAGING_D1_ID",
    "migrations_dir": "../migrations"
  }],
  "r2_buckets": [{ "binding": "PRIVATE_FILES", "bucket_name": "pch-ons2-private-staging" }]
}
