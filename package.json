{
  "name": "police-constitution-ox",
  "version": "0.0.2-canary",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:ons2": "wrangler dev --config cloudflare/wrangler.local.jsonc",
    "db:ons2:local": "wrangler d1 migrations apply DB --local --config cloudflare/wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ons2:runtime": "node --test tests/ons2-runtime.mjs tests/ons2-auth-runtime.mjs",
    "test:ons2:browser": "node --test tests/ons2-browser.mjs",
    "verify:book": "python3 scripts/verify_book.py",
    "build": "npm run typecheck && vite build",
    "build:ons2": "tsc -p tsconfig.worker.json && npm run typecheck && vite build --config cloudflare/vite.config.ts && node scripts/verify_worker_assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "preview:ons2:design": "node scripts/preview_ons2_design.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "better-auth": "1.7.28",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0",
    "wrangler": "4.168.0"
  }
}
